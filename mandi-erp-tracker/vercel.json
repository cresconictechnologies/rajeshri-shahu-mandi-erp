      "destination": "/api/portal?action=outward"
    },
    {
      "source": "/api/branch/farmers/register",
      "destination": "/api/portal?action=farmers"
    },
    {
      "source": "/api/branch/farmers/edit",
      "destination": "/api/portal?action=farmers"
    },
    {
      "source": "/api/branch/buyers/register",
      "destination": "/api/portal?action=buyers"
    },
    {
      "source": "/api/branch/settings",
      "destination": "/api/portal?action=summary"
    },
    {
      "source": "/api/system/updates/status",
      "destination": "/api/system-updates"
    },
    {
      "source": "/api/supabase/status",
      "destination": "/api/supabase-status"
    },
    {
      "source": "/api/supabase-status",
      "destination": "/api/supabase-status"
    },
    {
      "source": "/api/inspector/ocr-moisture",
      "destination": "/api/inspector-ocr"
    },
    {
      "source": "/api/ai/ocr-moisture",
      "destination": "/api/inspector-ocr"
    },
    {
      "source": "/api/inspector/analyze-sample",
      "destination": "/api/inspector-analyze"
    },
    {
      "source": "/api/ai/analyze-grain",
      "destination": "/api/inspector-analyze"
    },
    {
      "source": "/api/inspector/submit-qc",
      "destination": "/api/inspections-submit"
    },
    {
      "source": "/api/inspections/submit",
      "destination": "/api/inspections-submit"
    },
    {
      "source": "/api/inspections-submit",
      "destination": "/api/inspections-submit"
    },
    {
      "source": "/api/inspector/tickets/pending",
      "destination": "/api/portal?action=tickets"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}