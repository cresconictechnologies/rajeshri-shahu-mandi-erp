{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/app", "destination": "/app.html" },
    { "source": "/portal", "destination": "/portal.html" },
    { "source": "/login", "destination": "/portal.html" },
    { "source": "/branch", "destination": "/portal.html" },
    { "source": "/accounts", "destination": "/portal.html" },
    { "source": "/admin", "destination": "/portal.html" },
    { "source": "/api/portal/rates", "destination": "/api/portal?action=rates" },
    { "source": "/api/portal/invoices", "destination": "/api/portal?action=invoices" },
    { "source": "/api/portal/auth", "destination": "/api/portal?action=auth" },
    { "source": "/api/portal/summary", "destination": "/api/portal?action=summary" },
    { "source": "/api/system/updates/status", "destination": "/api/system-updates" },
    { "source": "/api/supabase/status", "destination": "/api/supabase-status" },
    { "source": "/api/supabase-status", "destination": "/api/supabase-status" },
    { "source": "/api/inspector/ocr-moisture", "destination": "/api/inspector-ocr" },
    { "source": "/api/ai/ocr-moisture", "destination": "/api/inspector-ocr" },
    { "source": "/api/inspector/analyze-sample", "destination": "/api/inspector-analyze" },
    { "source": "/api/ai/analyze-grain", "destination": "/api/inspector-analyze" },
    { "source": "/api/inspector/submit-qc", "destination": "/api/inspections-submit" },
    { "source": "/api/inspections/submit", "destination": "/api/inspections-submit" },
    { "source": "/api/inspections-submit", "destination": "/api/inspections-submit" },
    { "source": "/api/inspector/tickets/pending", "destination": "/api/inspections-submit" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
