    {
      "source": "/api/portal/buyers",
      "destination": "/api/portal?action=buyers"
    },
    {
      "source": "/api/portal/outward",
      "destination": "/api/portal?action=outward"
    },
    {
      "source": "/api/branch/rates",
      "destination": "/api/portal?action=rates"
    },
    {
      "source": "/api/branch/invoices/recent",
      "destination": "/api/portal?action=invoices"
    },
    {
      "source": "/api/branch/invoices/create",
      "destination": "/api/portal?action=invoices"
    },
    {
      "source": "/api/branch/inward-unified",
      "destination": "/api/portal?action=invoices"
    },
    {
      "source": "/api/branch/outward/create",
      "destination": "/api/portal?action=outward"
