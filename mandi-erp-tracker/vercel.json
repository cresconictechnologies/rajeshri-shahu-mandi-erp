      "destination": "/portal.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/logout",
      "destination": "/login.html"
    },
    {
      "source": "/branch",
      "destination": "/portal.html"
    },
    {
      "source": "/accounts",
      "destination": "/portal.html"
    },
    {
      "source": "/admin",
      "destination": "/portal.html"
    },
    {
      "source": "/api/invoices/calculate",
      "destination": "/api/portal?action=calculate"
    },
    {
